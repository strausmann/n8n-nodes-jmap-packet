{
  "name": "n8n-nodes-jmap-packet",
  "version": "1.0.0",
  "description": "JMAP nodes for n8n — mail, mailboxes and threads over JMAP (RFC 8620/8621). Works with Stalwart, Apache James, Twake Mail and Fastmail.",
  "keywords": [
    "n8n-community-node-package",
    "jmap",
    "email",
    "mail",
    "stalwart",
    "apache-james",
    "twake-mail",
    "fastmail",
    "rfc8620",
    "rfc8621"
  ],
  "license": "MIT",
  "homepage": "https://github.com/strausmann/n8n-nodes-jmap-packet",
  "author": {
    "name": "Björn Strausmann"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strausmann/n8n-nodes-jmap-packet.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts'",
    "lintfix": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts' --fix",
    "prepublishOnly": "npm run build && npm run lint -q"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JmapBasicAuthApi.credentials.js",
      "dist/credentials/JmapBearerTokenApi.credentials.js",
      "dist/credentials/JmapOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Jmap/Jmap.node.js",
      "dist/nodes/Jmap/JmapTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "contributors": [
    {
      "name": "Michel-Marie Maudet",
      "url": "https://github.com/mmaudet",
      "comment": "original author of n8n-nodes-jmap, which this package is based on"
    }
  ],
  "bugs": {
    "url": "https://github.com/strausmann/n8n-nodes-jmap-packet/issues"
  }
}

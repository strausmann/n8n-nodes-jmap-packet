{
  "name": "n8n-nodes-jmap-packet",
  "version": "0.0.0-development",
  "description": "JMAP nodes for n8n \u2014 mail, mailboxes and threads over JMAP (RFC 8620/8621). Works with Stalwart, Apache James, Twake Mail and Fastmail.",
  "keywords": [
    "n8n-community-node-package",
    "jmap",
    "email",
    "mail",
    "stalwart",
    "apache-james",
    "twake-mail",
    "fastmail",
    "rfc8620",
    "rfc8621"
  ],
  "license": "MIT",
  "homepage": "https://github.com/strausmann/n8n-nodes-jmap-packet",
  "author": {
    "name": "Bj\u00f6rn Strausmann"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strausmann/n8n-nodes-jmap-packet.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts'",
    "lintfix": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts' --fix",
    "prepublishOnly": "npm run build && npm run lint -q",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JmapBasicAuthApi.credentials.js",
      "dist/credentials/JmapBearerTokenApi.credentials.js",
      "dist/credentials/JmapOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Jmap/Jmap.node.js",
      "dist/nodes/Jmap/JmapTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^8.56.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.2.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "contributors": [
    {
      "name": "Michel-Marie Maudet",
      "url": "https://github.com/mmaudet",
      "comment": "original author of n8n-nodes-jmap, which this package is based on"
    }
  ],
  "bugs": {
    "url": "https://github.com/strausmann/n8n-nodes-jmap-packet/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "conventional-changelog-writer": "9.2.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
